# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Coupler.io
COUPLER_API_KEY=your-coupler-api-key

# Cron secret (set this to a random string, used to authenticate cron requests)
CRON_SECRET=your-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Candidate Delivery Dashboard (Notion placements sync) ---
# Notion internal integration token (https://www.notion.so/my-integrations).
# Share the "Candidate Delivery Dashboard" page with this integration.
NOTION_TOKEN=ntn_xxx
# Random string used in the Notion "Refresh" button URL (?key=...). Make one up.
PLACEMENTS_REFRESH_SECRET=your-refresh-secret
# Google service account that can READ the Signed Offers sheet.
# From the service-account JSON key file: client_email and private_key.
# Paste the private key exactly; keep the \n escapes (the code un-escapes them).
GOOGLE_SERVICE_ACCOUNT_EMAIL=tmv-dashboard@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Optional overrides — defaults already point at the live TMV sheet/dashboard.
# SIGNED_OFFERS_SHEET_ID=15tl16CvD3Vy5ls0L4Yc2NffsZGBcjUZLml1PzndS8c4
# SIGNED_OFFERS_TAB=Signed Offers
# NOTION_PLACEMENTS_DB_ID=cc62dc691dde44bfbaf91d5b7f2217e8
# NOTION_DASHBOARD_PAGE_ID=3896130c-d1c1-81af-b7c4-f275b13d6d31

# --- Dashboard login (Google OAuth, restricted to your company domain) ---
# This is a SEPARATE Google credential from the service account above:
# an OAuth 2.0 Client ID (Web application). See docs/PLACEMENTS-DASHBOARD-SETUP.md.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
# Long random string for signing login sessions (e.g. `openssl rand -base64 32`).
NEXTAUTH_SECRET=replace-with-random-string
# Your deployed URL, no trailing slash.
NEXTAUTH_URL=https://your-app.vercel.app
# Only this email domain may sign in.
ALLOWED_EMAIL_DOMAIN=themilvet.org
